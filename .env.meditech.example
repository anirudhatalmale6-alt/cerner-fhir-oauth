# ============================================================================
#  MEDITECH profile — switching EMRs is JUST this file.
#  Copy to ".env" (cp .env.meditech.example .env), fill in your Meditech values,
#  then: make build && make run. Same binary as Cerner, different config.
#
#  Fill these from your Meditech developer portal (Greenfield) app registration.
# ============================================================================

# How Meditech wants you to authenticate to its token endpoint. Pick ONE:
#   private_key_jwt     -> if Meditech registered your PUBLIC key (like Cerner).
#                          Then set EMR_KEY_ID + EMR_PRIVATE_KEY_PATH below.
#   client_secret_post  -> if Meditech gave you a Client Secret (in POST body).
#   client_secret_basic -> if Meditech gave you a Client Secret (HTTP Basic).
TOKEN_AUTH_METHOD=client_secret_post

AUTH_MODE=backend

# --- Credentials from the Meditech app registration -------------------------
EMR_CLIENT_ID=REPLACE_WITH_YOUR_MEDITECH_CLIENT_ID

# Only for the client_secret_* methods:
EMR_CLIENT_SECRET=REPLACE_WITH_YOUR_MEDITECH_CLIENT_SECRET

# Only for private_key_jwt (leave blank otherwise):
EMR_KEY_ID=
EMR_PRIVATE_KEY_PATH=keys/private.pem

# Scopes Meditech authorized for the app:
EMR_SCOPES=system/Patient.read

# --- Meditech endpoints (get the exact URLs from your Meditech portal) ------
EMR_TOKEN_URL=REPLACE_WITH_MEDITECH_TOKEN_URL
EMR_FHIR_BASE_URL=REPLACE_WITH_MEDITECH_FHIR_R4_BASE_URL

# --- The patient you want to pull -------------------------------------------
PATIENT_ID=REPLACE_WITH_A_MEDITECH_PATIENT_ID
PATIENT_MRN=
PATIENT_MRN_SYSTEM=
