# ============================================================================
#  Copy this file to ".env" and fill in the values from YOUR Cerner Code Console.
#  cp .env.example .env
#
#  The four *_URL / *_ID values below are pre-filled with the PUBLIC Cerner
#  sandbox tenant so you can see the shape. Replace CERNER_CLIENT_ID (and, when
#  you register your own app, the tenant in the URLs) with your own.
# ============================================================================

# --- Where each value comes from in the Cerner Code Console -----------------
# 1. Sign in / register at https://code.cerner.com  (free).
# 2. Create a NEW app:  App Type = "Provider",  scheme = "System" (backend).
# 3. After creating it, the app's detail page shows:
#      - "Client ID"  ->  CERNER_CLIENT_ID
#      - the sandbox "Tenant" (a GUID) that goes inside the two URLs below.
# 4. Under "System Account" / keys, upload keys/public.pem (from `make keygen`);
#    Cerner then shows a key id -> CERNER_KEY_ID.
# 5. Grant the app the "system/Patient.read" scope.

# The App/Client ID from the console (REQUIRED — replace this):
CERNER_CLIENT_ID=REPLACE_WITH_YOUR_CLIENT_ID

# The kid of the public key you uploaded (optional but recommended):
CERNER_KEY_ID=

# Space-separated scopes your app is authorized for:
CERNER_SCOPES=system/Patient.read

# Path to YOUR private key (generated by `make keygen`; never commit it):
CERNER_PRIVATE_KEY_PATH=keys/private.pem

# --- Endpoints (public Cerner sandbox tenant ec2458f2-...) -------------------
# Token endpoint (secure/authenticated tenant):
CERNER_TOKEN_URL=https://authorization.cerner.com/tenants/ec2458f2-1e24-41c8-b71b-0e701af7583d/protocols/oauth2/profiles/smart-v1/token

# FHIR R4 base URL (secure/authenticated tenant):
CERNER_FHIR_BASE_URL=https://fhir-ehr-code.cerner.com/r4/ec2458f2-1e24-41c8-b71b-0e701af7583d

# --- The patient you want to pull -------------------------------------------
# A known Cerner R4 sandbox patient id you can start with:
PATIENT_ID=12724066

# MRN search: value + (optional) the identifier "system" the MRN belongs to.
# Leave PATIENT_MRN empty to skip the MRN search. The values below are a REAL
# MRN for sandbox patient 12724066 (verified to return exactly that patient):
PATIENT_MRN=6000031
PATIENT_MRN_SYSTEM=urn:oid:2.16.840.1.113883.3.787.0.0
